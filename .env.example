PSB_KNOWLEDGE_ADMIN_PASSWORD=
PSB_KNOWLEDGE_PORT=5433
PSB_DATABASE_URL=
TEST_DATABASE_URL=
PSB_CONTAINER_DATABASE_URL=
PSB_SITE_PORT=8080
# Локально HTTP. За внешним HTTPS reverse proxy: https и Secure=true.
PSB_PUBLIC_SCHEME=http
PSB_COOKIE_SECURE=false
# Полный allowlist; в production замените на https://ваш-домен.
PSB_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
PSB_DEV_API_UPSTREAM=http://127.0.0.1:8000
# Выделенная сеть API/Nginx. IP Nginx находится вне динамического пула.
PSB_WEB_SUBNET=172.30.80.0/24
PSB_WEB_DYNAMIC_RANGE=172.30.80.128/25
PSB_FRONTEND_PROXY_IP=172.30.80.2
LLM_BASE_URL=
LLM_API_KEY=
EMB_MODEL=BAAI/bge-m3

# Генерация DeepSeek. Заполните URL, ключ и ID модели для включения клиента.
# LLM_BASE_URL / LLM_API_KEY выше остаются настройками BGE-M3.
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Тайм-аут HTTP-запроса в секундах.
DEEPSEEK_TIMEOUT=60
